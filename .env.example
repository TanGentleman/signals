# signals — fill these in, then run ./signals setup

# Your Cloudflare domain (the zone you'll attach routes/tunnels to)
DOMAIN=yourdomain.com

# Signal phone numbers in E.164 format (+1XXXXXXXXXX)
SIGNAL_ACCOUNT=+1XXXXXXXXXX
SIGNAL_RECIPIENT=+1XXXXXXXXXX

# Optional: stable webhook token (non-empty)
# If set, `./signals up` will redeploy worker auth with this token.
# SIGNAL_WEBHOOK_TOKEN=
