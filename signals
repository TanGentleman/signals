#!/usr/bin/env bash
set -euo pipefail

readonly APP_NAME="signals"
readonly CONTAINER_NAME="signal-bridge"
readonly TUNNEL_NAME="signal-bridge"
readonly WORKER_NAME="signal-agent"
readonly PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly ENV_FILE="$PROJECT_DIR/.env"
readonly ENV_EXAMPLE_FILE="$PROJECT_DIR/.env.example"
readonly WRANGLER_CONFIG="wrangler.toml"
readonly WRANGLER_CONFIG_EXAMPLE="wrangler.toml.example"
readonly LOCAL_API="http://localhost:8080"
readonly CF_DIR="$HOME/.cloudflared"
readonly CF_CONFIG="$CF_DIR/config.yml"
readonly PIDFILE="/tmp/${APP_NAME}-${TUNNEL_NAME}.pid"
readonly UUID_REGEX='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

DOMAIN=""
SIGNAL_ACCOUNT=""
SIGNAL_RECIPIENT=""
TUNNEL_HOST=""
WORKER_URL=""
TUNNEL_ID=""
DEPLOY_TOKEN=""

log() {
  printf '%s\n' "$*"
}

die() {
  log "ERROR: $*"
  exit 1
}

confirm() {
  local prompt="$1"
  local default="${2:-N}"
  local answer

  if [[ "$default" == "Y" ]]; then
    read -r -p "$prompt [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]
    return
  fi

  read -r -p "$prompt [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

mask() {
  local value="${1:-}"
  if [[ ${#value} -le 6 ]]; then
    printf '%s' "$value"
  else
    printf '%s' "${value:0:4}...${value: -2}"
  fi
}

extract_uuid() {
  grep -oE "$UUID_REGEX" | head -1
}

decode_b64_to_file() {
  local data="$1"
  local file="$2"
  printf '%s' "$data" | base64 --decode >"$file" 2>/dev/null && return 0
  printf '%s' "$data" | base64 -D >"$file" 2>/dev/null && return 0
  return 1
}

wait_for_url() {
  local url="$1"
  local max_seconds="$2"
  local i
  for i in $(seq 1 "$max_seconds"); do
    if curl -sf "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

require_cmd() {
  local missing=()
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    log "Missing required commands:"
    printf '  - %s\n' "${missing[@]}"
    die "Install the missing dependencies and retry."
  fi
}

require_env() {
  local var_name="$1"
  local value="${!var_name:-}"
  if [[ -z "$value" || "$value" == *"yourdomain"* || "$value" == *"XXXXXXXXXX"* ]]; then
    die "$var_name is not set correctly in $ENV_FILE"
  fi
}

load_env() {
  [[ -f "$ENV_FILE" ]] || die "No .env found. Run './signals init' first."
  # shellcheck disable=SC1091
  source "$ENV_FILE"
  require_env DOMAIN
  require_env SIGNAL_ACCOUNT
  require_env SIGNAL_RECIPIENT

  TUNNEL_HOST="${TUNNEL_NAME}.${DOMAIN}"
  WORKER_URL="https://${WORKER_NAME}.${DOMAIN}/notify"
}

check_prereqs() {
  require_cmd docker cloudflared node npm npx curl openssl base64 grep head
}

ensure_wrangler_config() {
  local wrangler_path="$PROJECT_DIR/$WRANGLER_CONFIG"
  if [[ -f "$wrangler_path" ]]; then
    return
  fi
  if [[ -f "$PROJECT_DIR/$WRANGLER_CONFIG_EXAMPLE" ]]; then
    die "Missing $WRANGLER_CONFIG. Run: cp $WRANGLER_CONFIG_EXAMPLE $WRANGLER_CONFIG (then set your route)."
  fi
  die "Missing $WRANGLER_CONFIG and $WRANGLER_CONFIG_EXAMPLE."
}

valid_domain() {
  local domain="$1"
  [[ "$domain" =~ ^([A-Za-z0-9-]+\.)+[A-Za-z]{2,}$ ]]
}

valid_e164() {
  local number="$1"
  [[ "$number" =~ ^\+[1-9][0-9]{7,14}$ ]]
}

valid_token() {
  local token="$1"
  [[ -n "$token" ]]
}

prompt_domain() {
  local default="$1"
  local value

  while true; do
    if [[ -n "$default" ]]; then
      read -r -p "Cloudflare domain (example.com) [$default]: " value
      value="${value:-$default}"
    else
      read -r -p "Cloudflare domain (example.com): " value
    fi

    if valid_domain "$value"; then
      printf '%s' "$value"
      return
    fi
    log "Please enter a valid domain, e.g. example.com"
  done
}

prompt_e164() {
  local label="$1"
  local default="$2"
  local value

  while true; do
    if [[ -n "$default" ]]; then
      read -r -p "$label [$default]: " value
      value="${value:-$default}"
    else
      read -r -p "$label: " value
    fi

    if valid_e164 "$value"; then
      printf '%s' "$value"
      return
    fi
    log "Enter an E.164 number like +14155550123"
  done
}

write_env_file() {
  local domain="$1"
  local account="$2"
  local recipient="$3"
  cat >"$ENV_FILE" <<EOF
# signals — generated by ./signals init
DOMAIN=$domain
SIGNAL_ACCOUNT=$account
SIGNAL_RECIPIENT=$recipient
# Optional: stable webhook token (non-empty)
# SIGNAL_WEBHOOK_TOKEN=
EOF
}

write_wrangler_file() {
  local domain="$1"
  local wrangler_path="$PROJECT_DIR/$WRANGLER_CONFIG"
  cat >"$wrangler_path" <<EOF
name = "$WORKER_NAME"
main = "src/index.ts"
compatibility_date = "2026-02-25"

routes = [{ pattern = "${WORKER_NAME}.${domain}/*", zone_name = "${domain}" }]
workers_dev = false

# Secrets — set via CLI (never commit these):
#   npx wrangler secret put SIGNAL_CLI_URL        # https://signal-bridge.yourdomain.com
#   npx wrangler secret put SIGNAL_ACCOUNT        # +1xxx E.164 format
#   npx wrangler secret put SIGNAL_RECIPIENT      # +1xxx E.164 format
#   npx wrangler secret put SIGNAL_WEBHOOK_TOKEN  # openssl rand -hex 32
EOF
}

docker_running() {
  docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}\$"
}

docker_exists() {
  docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}\$"
}

ensure_docker() {
  if docker_running; then
    log "Docker: ${CONTAINER_NAME} already running"
  elif docker_exists; then
    log "Starting ${CONTAINER_NAME} container..."
    docker start "$CONTAINER_NAME" >/dev/null
    log "Docker: ${CONTAINER_NAME} started"
  else
    log "Creating ${CONTAINER_NAME} container..."
    docker run -d --name "$CONTAINER_NAME" \
      --restart unless-stopped \
      -p 8080:8080 \
      -v "$HOME/.local/share/signal-cli:/home/.local/share/signal-cli" \
      -e MODE=native \
      bbernhard/signal-cli-rest-api >/dev/null
    log "Docker: ${CONTAINER_NAME} created"
  fi

  wait_for_url "${LOCAL_API}/v1/about" 10 || die "signal-cli-rest-api not reachable after 10s"
  log "signal-cli-rest-api reachable"
}

tunnel_running() {
  [[ -f "$PIDFILE" ]] || return 1
  local pid
  pid="$(<"$PIDFILE")"
  kill -0 "$pid" >/dev/null 2>&1
}

write_cloudflared_config() {
  mkdir -p "$CF_DIR"
  cat >"$CF_CONFIG" <<EOF
tunnel: $TUNNEL_ID
credentials-file: $CF_DIR/$TUNNEL_ID.json

ingress:
  - hostname: $TUNNEL_HOST
    service: http://localhost:8080
  - service: http_status:404
EOF
  log "Wrote $CF_CONFIG"
}

ensure_tunnel() {
  local info_out token

  if cloudflared tunnel info "$TUNNEL_NAME" >/dev/null 2>&1; then
    log "Tunnel '${TUNNEL_NAME}' already exists"
    info_out="$(cloudflared tunnel info "$TUNNEL_NAME" 2>&1 || true)"
    TUNNEL_ID="$(printf '%s' "$info_out" | extract_uuid)"
    [[ -n "$TUNNEL_ID" ]] || die "Could not determine tunnel ID for ${TUNNEL_NAME}"

    if [[ ! -f "$CF_DIR/$TUNNEL_ID.json" ]]; then
      log "Tunnel credentials missing locally. Re-authenticating..."
      cloudflared tunnel login
      token="$(cloudflared tunnel token "$TUNNEL_NAME" 2>/dev/null || true)"
      if [[ -z "$token" ]]; then
        die "Could not fetch tunnel token. Copy $CF_DIR/$TUNNEL_ID.json from original machine."
      fi
      decode_b64_to_file "$token" "$CF_DIR/$TUNNEL_ID.json" || die "Could not decode tunnel credentials."
      log "Tunnel credentials saved to $CF_DIR/$TUNNEL_ID.json"
    fi
    return
  fi

  [[ -f "$CF_DIR/cert.pem" ]] || {
    log "Logging into Cloudflare (browser opens)..."
    cloudflared tunnel login
  }

  log "Creating tunnel '${TUNNEL_NAME}'..."
  info_out="$(cloudflared tunnel create "$TUNNEL_NAME" 2>&1 || true)"
  TUNNEL_ID="$(printf '%s' "$info_out" | extract_uuid)"
  [[ -n "$TUNNEL_ID" ]] || die "Tunnel creation failed. Output: $info_out"

  log "Routing DNS for ${TUNNEL_HOST}..."
  cloudflared tunnel route dns -f "$TUNNEL_NAME" "$TUNNEL_HOST" >/dev/null
}

start_tunnel_background() {
  if tunnel_running; then
    log "Tunnel already running (pid $(<"$PIDFILE"))"
    return
  fi

  [[ -f "$CF_CONFIG" ]] || die "Missing $CF_CONFIG. Run './signals setup' first."

  log "Starting tunnel in background..."
  cloudflared tunnel --config "$CF_CONFIG" run >/dev/null 2>&1 &
  local pid=$!
  echo "$pid" >"$PIDFILE"

  if wait_for_url "https://${TUNNEL_HOST}/v1/about" 15; then
    log "Tunnel running (pid $pid) at https://${TUNNEL_HOST}"
  else
    log "WARNING: tunnel started (pid $pid) but is not reachable yet"
  fi
}

stop_tunnel() {
  if tunnel_running; then
    local pid
    pid="$(<"$PIDFILE")"
    kill "$pid" >/dev/null 2>&1 || true
    log "Tunnel stopped (pid $pid)"
  else
    log "Tunnel was not running"
  fi
  rm -f "$PIDFILE"
}

stop_tunnel_processes() {
  local pattern="cloudflared tunnel --config $CF_CONFIG run"
  local pids=""

  # First stop the PID-file managed tunnel (setup path).
  stop_tunnel >/dev/null 2>&1 || true

  # Then stop any foreground/background tunnel started via `signals up`.
  if command -v pgrep >/dev/null 2>&1; then
    pids="$(pgrep -f "$pattern" || true)"
    if [[ -n "$pids" ]]; then
      log "Stopping active cloudflared tunnel process(es)..."
      while IFS= read -r pid; do
        [[ -n "$pid" ]] || continue
        kill "$pid" >/dev/null 2>&1 || true
      done <<<"$pids"
      sleep 1
      pids="$(pgrep -f "$pattern" || true)"
      if [[ -n "$pids" ]]; then
        while IFS= read -r pid; do
          [[ -n "$pid" ]] || continue
          kill -9 "$pid" >/dev/null 2>&1 || true
        done <<<"$pids"
      fi
      log "Tunnel process cleanup complete"
    fi
  fi
}

put_secret() {
  local key="$1"
  local value="$2"
  npx wrangler secret put "$key" <<<"$value" >/dev/null 2>&1
}

deploy_worker() {
  local token="${1:-}"
  [[ -n "$token" ]] || token="$(openssl rand -hex 32)"
  valid_token "$token" || die "Invalid token. Token must be non-empty."

  log "Setting worker secrets..."
  put_secret SIGNAL_CLI_URL "https://${TUNNEL_HOST}"
  put_secret SIGNAL_ACCOUNT "$SIGNAL_ACCOUNT"
  put_secret SIGNAL_RECIPIENT "$SIGNAL_RECIPIENT"
  put_secret SIGNAL_WEBHOOK_TOKEN "$token"

  log "Deploying worker..."
  npm run deploy --silent >/dev/null

  DEPLOY_TOKEN="$token"
  log "Worker deployed"
  log "Token: $token"
}

e2e_test() {
  local token="$1"
  local output_file="/tmp/signal-e2e.json"
  local http body
  local max_attempts=3
  local attempt

  log "Running E2E test..."
  for attempt in $(seq 1 "$max_attempts"); do
    http="$(
      curl -sS -o "$output_file" -w "%{http_code}" \
        --max-time 15 \
        -X POST "$WORKER_URL" \
        -H "Content-Type: application/json" \
        -H "X-Webhook-Token: $token" \
        -d '{"message":"signals test"}' || true
    )"

    if [[ "$http" == "200" ]]; then
      log "E2E passed; check Signal for the test message."
      return 0
    fi

    if [[ $attempt -lt $max_attempts ]]; then
      log "Attempt $attempt/$max_attempts got HTTP ${http:-unknown}, retrying in 3s..."
      sleep 3
    fi
  done

  body="$(<"$output_file" 2>/dev/null || true)"
  die "E2E failed after $max_attempts attempts (HTTP ${http:-unknown}): $body"
}

usage() {
  cat <<EOF
$APP_NAME - Send Signal messages from the cloud

Usage:
  ./signals init              Create local .env + wrangler.toml
  ./signals setup             First-time setup + deploy + test
  ./signals setup --no-deploy First-time setup only (no worker deploy)
  ./signals up                Start tunnel + docker
  ./signals up <token>        Start + redeploy worker with token
  ./signals down              Stop docker container
  ./signals uninstall         Remove tunnel/worker/container/config
EOF
}

cmd_init() {
  local existing_domain="" existing_account="" existing_recipient=""
  local domain account recipient

  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE" || true
    existing_domain="${DOMAIN:-}"
    existing_account="${SIGNAL_ACCOUNT:-}"
    existing_recipient="${SIGNAL_RECIPIENT:-}"
  fi

  if [[ -f "$ENV_FILE" ]] && ! confirm "$ENV_FILE exists. Overwrite?" "N"; then
    log "Keeping existing .env"
  else
    domain="$(prompt_domain "$existing_domain")"
    account="$(prompt_e164 "Signal account number (E.164)" "$existing_account")"
    recipient="$(prompt_e164 "Signal recipient number (E.164)" "$existing_recipient")"
    write_env_file "$domain" "$account" "$recipient"
    log "Wrote $ENV_FILE"
  fi

  domain="${domain:-$existing_domain}"
  if [[ -z "$domain" ]]; then
    # If .env was kept and didn't parse cleanly, ask once.
    domain="$(prompt_domain "")"
  fi

  if [[ -f "$PROJECT_DIR/$WRANGLER_CONFIG" ]] && ! confirm "$WRANGLER_CONFIG exists. Overwrite?" "N"; then
    log "Keeping existing $WRANGLER_CONFIG"
  else
    write_wrangler_file "$domain"
    log "Wrote $PROJECT_DIR/$WRANGLER_CONFIG"
  fi

  log ""
  log "Config complete."
  log "Next: ./signals setup"
}

cmd_setup() {
  local token cleanup="0"
  local no_deploy="0"
  local setup_arg="${1:-}"

  if [[ "$setup_arg" == "--no-deploy" ]]; then
    no_deploy="1"
  elif [[ -n "$setup_arg" ]]; then
    die "Unknown setup option: $setup_arg"
  fi

  load_env
  check_prereqs
  trap '[[ "$cleanup" == "1" ]] && stop_tunnel >/dev/null 2>&1 || true' EXIT

  log "Domain:    $DOMAIN"
  log "Account:   $(mask "$SIGNAL_ACCOUNT")"
  log "Recipient: $(mask "$SIGNAL_RECIPIENT")"
  log ""

  log "--- Docker ---"
  ensure_docker
  log ""

  log "--- Link Signal Device ---"
  log "Open: ${LOCAL_API}/v1/qrcodelink?device_name=mac"
  log "Then in Signal: Settings > Linked Devices > scan QR"
  read -rp "Press Enter once linked (or skip if already done)..."
  log ""

  log "--- Cloudflare Tunnel ---"
  ensure_tunnel
  log "Tunnel ID: $TUNNEL_ID"
  write_cloudflared_config
  log ""

  if [[ "$no_deploy" == "1" ]]; then
    trap - EXIT
    cat <<EOF
==========================================
Setup complete (no deploy).
Worker route: $WORKER_URL

When ready, deploy + start with:
  ./signals up "<your-token>"
==========================================
EOF
    return
  fi

  log "--- Start Tunnel ---"
  start_tunnel_background
  cleanup="1"
  log ""

  log "--- Deploy Worker ---"
  ensure_wrangler_config
  npm install --silent >/dev/null
  deploy_worker "${SIGNAL_WEBHOOK_TOKEN:-}"
  token="$DEPLOY_TOKEN"
  log ""

  log "--- Test ---"
  log "Waiting for worker + tunnel to settle..."
  sleep 3
  e2e_test "$token"
  log ""

  stop_tunnel >/dev/null 2>&1 || true
  cleanup="0"
  trap - EXIT

  cat <<EOF
==========================================
Setup complete.
Worker: $WORKER_URL
Token:  $token

Start the tunnel:
  ./signals up "$token"
==========================================
EOF
}

cmd_up() {
  local token="${1:-}"
  local redeploy_source=""
  local tunnel_pid=""

  load_env
  check_prereqs

  log "Starting signals..."
  ensure_docker

  [[ -f "$CF_CONFIG" ]] || die "Missing $CF_CONFIG. Run './signals setup' first."
  ensure_wrangler_config

  if [[ -n "$token" ]]; then
    redeploy_source="argument"
  elif [[ -n "${SIGNAL_WEBHOOK_TOKEN:-}" ]]; then
    token="$SIGNAL_WEBHOOK_TOKEN"
    redeploy_source=".env"
  fi

  if [[ -n "$redeploy_source" ]]; then
    valid_token "$token" || die "Invalid token from $redeploy_source. Token must be non-empty."
    log "Redeploying worker with token from ${redeploy_source}..."
    deploy_worker "$token"
  fi

  log "signals is up at $WORKER_URL"
  log "Press Ctrl+C to stop tunnel."
  trap 'log ""; [[ -n "$tunnel_pid" ]] && kill "$tunnel_pid" >/dev/null 2>&1 || true; log "Tunnel stopped"; exit 0' INT TERM

  if [[ -n "$redeploy_source" ]]; then
    # Keep tunnel running while we verify the fresh token.
    cloudflared tunnel --config "$CF_CONFIG" run &
    tunnel_pid=$!

    log "Waiting for tunnel to become reachable..."
    wait_for_url "https://${TUNNEL_HOST}/v1/about" 20 || die "Tunnel not reachable; cannot verify token registration."

    log "Verifying token registration..."
    e2e_test "$token"
    log "Worker redeployed"

    wait "$tunnel_pid"
    return
  fi

  cloudflared tunnel --config "$CF_CONFIG" run
}

cmd_down() {
  log "Stopping signals..."
  stop_tunnel_processes
  docker stop "$CONTAINER_NAME" >/dev/null 2>&1 \
    && log "Docker container stopped" \
    || log "Container not running"
  log "Tunnel process stopped (if running)"
}

cmd_uninstall() {
  local confirm

  check_prereqs

  cat <<EOF
This will remove:
  - Cloudflare tunnel '${TUNNEL_NAME}' and its DNS route
  - Docker container '${CONTAINER_NAME}'
  - $CF_CONFIG
  - Cloudflare Worker '${WORKER_NAME}'
EOF
  read -rp "Continue? [y/N] " confirm
  [[ "$confirm" == [yY] ]] || {
    log "Aborted."
    exit 0
  }

  stop_tunnel_processes

  log "Deleting worker..."
  npx wrangler delete --name "$WORKER_NAME" >/dev/null 2>&1 || log "(worker not found or already deleted)"

  log "Deleting tunnel..."
  cloudflared tunnel cleanup "$TUNNEL_NAME" >/dev/null 2>&1 || true
  cloudflared tunnel delete "$TUNNEL_NAME" >/dev/null 2>&1 || log "(tunnel not found or already deleted)"

  rm -f "$CF_CONFIG"
  log "Removed $CF_CONFIG"

  log "Removing Docker container..."
  docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
  docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || log "(container not found)"
  log "Docker container removed"

  log "Uninstalled. Signal data remains in ~/.local/share/signal-cli"
}

main() {
  cd "$PROJECT_DIR"
  case "${1:-}" in
    init) cmd_init ;;
    setup) cmd_setup "${2:-}" ;;
    up) cmd_up "${2:-}" ;;
    down) cmd_down ;;
    uninstall) cmd_uninstall ;;
    -h|--help|help|"") usage ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
